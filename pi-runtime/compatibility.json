      "capabilities": [
        "rpc.lifecycle",
        "images.prompt"
      ]
    },
    {
      "id": "model-egress-runtime",
      "description": "Run the packaged Pi Anthropic Messages, OpenAI Chat Completions, and OpenAI Responses adapters through model-only isolation, proving exact broker routes, complete stream lifecycle, and absence of model credentials in the worker process tree.",
      "capabilities": [
        "providers.models"
      ]
    },
      {
        "id": "session-recovery",
        "description": "Resume, fork, edit history, compact context, restart the client, and verify the intended branch and summary remain active.",
