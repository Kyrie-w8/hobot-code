          "extensions.lifecycle",
          "resources.discovery",
          "tools.parallel"
        ]
      },
      {
        "id": "readiness-diagnostics",
        "description": "Inspect installation and runtime readiness without creating support data or calling a model, require explicit repair confirmation, and restrict changes to the declared private-runtime permission allowlist.",
