{
  "env_file": "/etc/aster/aster.env",
  "provider": {
    "type": "anthropic",
    "model": "kimi-k3",
    "base_url": "https://ai-api.d-robotics.cc",
    "api_key_env": "ANTHROPIC_AUTH_TOKEN",
    "auth_style": "bearer",
    "timeout_seconds": 3000,
    "settings": {
      "max_tokens": 8192
    }
  }
}
