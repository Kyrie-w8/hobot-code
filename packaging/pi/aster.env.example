# D-Robotics Anthropic-compatible model gateway.
ANTHROPIC_BASE_URL=https://ai-api.d-robotics.cc
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=kimi-k3

# Hobot Code runtime locations. Existing ASTER_* names remain supported during migration.
# HOBOT_CODING_AGENT_DIR=/etc/aster/agent
# HOBOT_CODING_AGENT_SESSION_DIR=/var/lib/aster/pi-sessions

# Pi-compatible runtime controls.
PI_SKIP_VERSION_CHECK=1
