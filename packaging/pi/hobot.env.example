# D-Robotics Anthropic-compatible model gateway.
ANTHROPIC_BASE_URL=https://ai-api.d-robotics.cc
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=kimi-k3
# Override these only when the selected gateway model advertises different limits.
HOBOT_CODE_MODEL_CONTEXT_WINDOW=1000000
HOBOT_CODE_MODEL_MAX_TOKENS=8192

# Hobot Code uses ~/.config/hobot-code and ~/.local/state/hobot-code by default.
# Override only for managed deployments.
# HOBOT_CODE_CONFIG_DIR=/custom/config/hobot-code
# HOBOT_CODE_STATE_DIR=/custom/state/hobot-code
# HOBOT_CODING_AGENT_DIR=/custom/config/hobot-code/agent
# HOBOT_CODING_AGENT_SESSION_DIR=/custom/state/hobot-code/sessions

# Pi-compatible runtime controls.
PI_SKIP_VERSION_CHECK=1
