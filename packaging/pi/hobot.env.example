# D-Robotics Anthropic-compatible model gateway.
ANTHROPIC_BASE_URL=https://ai-api.d-robotics.cc
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=kimi-k3

# Hobot Code runtime locations. Override only for managed deployments.
# HOBOT_CODING_AGENT_DIR=/etc/hobot-code/agent
# HOBOT_CODING_AGENT_SESSION_DIR=/var/lib/hobot-code/sessions

# Pi-compatible runtime controls.
PI_SKIP_VERSION_CHECK=1
