# D-Robotics Anthropic-compatible model gateway.
ANTHROPIC_BASE_URL=https://ai-api.d-robotics.cc
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=kimi-k3
# Hard deadline for each model-gateway request; numeric values are clamped to
# 1000..3600000 milliseconds.
API_TIMEOUT_MS=3000000
# Override these only when the selected gateway model advertises different limits.
HOBOT_CODE_MODEL_CONTEXT_WINDOW=1000000
HOBOT_CODE_MODEL_MAX_TOKENS=8192

# Hobot Code uses ~/.config/hobot-code and ~/.local/state/hobot-code by default.
# Override only for managed deployments.
# Set HOBOT_CODE_CONFIG_DIR, XDG_CONFIG_HOME, and XDG_STATE_HOME in the invoking
# shell because they determine where this file is loaded from.
# HOBOT_CODE_STATE_DIR=/custom/state/hobot-code
# HOBOT_CODING_AGENT_DIR=/custom/config/hobot-code/agent
# HOBOT_CODING_AGENT_SESSION_DIR=/custom/state/hobot-code/sessions
# Every individual path override must also be absolute.
# HOBOT_CODE_PERMISSION_POLICY=/custom/config/hobot-code/agent/permissions.json
# HOBOT_CODE_MEMORY_CONFIG=/custom/config/hobot-code/agent/memory.json
# HOBOT_CODE_MEMORY_DB=/custom/state/hobot-code/memory/memory.db
# HOBOT_CODE_GOAL_CONFIG=/custom/config/hobot-code/agent/goals.json
# HOBOT_CODE_GOAL_DB=/custom/state/hobot-code/goals/goals.db
# HOBOT_CODE_HOOK_CONFIG=/custom/config/hobot-code/agent/hooks.json
# HOBOT_CODE_HOOK_AUDIT=/custom/state/hobot-code/audit/hooks.jsonl
# HOBOT_CODE_NOTIFICATION_CONFIG=/custom/config/hobot-code/agent/notifications.json
# HOBOT_CODE_LSP_CONFIG=/custom/config/hobot-code/agent/lsp.json
# HOBOT_CODE_MANAGED_PROVIDER_CONFIG=/custom/config/hobot-code/agent/providers.json
# HOBOT_CODE_RDK_KNOWLEDGE_DIR=/custom/share/hobot-code/knowledge
# HOBOT_CODE_RDK_EXPERT_PROMPT=/custom/share/hobot-code/prompts/rdk-expert.md
# Foreground TUI isolation: system (default), workspace, review, or off.
# system exposes only the supported RDK device allowlist; network is shared.
# HOBOT_CODE_TUI_SANDBOX=system
# HOBOT_CODE_TUI_NETWORK=shared

# Pi-compatible runtime controls.
PI_SKIP_VERSION_CHECK=1
