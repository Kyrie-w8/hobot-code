#!/bin/sh
set -eu

if [ -z "${HOME:-}" ]; then
  printf 'HOME must be set to run Hobot Code\n' >&2
  exit 1
fi

require_absolute_path() {
  path_name=$1
  path_value=$2
  case "$path_value" in
    /*) ;;
    *)
      printf '%s must be an absolute path: %s\n' "$path_name" "$path_value" >&2
      exit 1
      ;;
  esac
}

require_scoped_private_root() {
  root_name=$1
  root_value=$2
  case "$root_value" in
    /|"$HOME"|/bin|/boot|/dev|/etc|/home|/lib|/lib64|/mnt|/opt|/proc|/root|/run|/sbin|/srv|/sys|/tmp|/usr|/var)
      printf '%s must identify a scoped private directory, not a broad system or home root: %s\n' "$root_name" "$root_value" >&2
      exit 1
      ;;
  esac
}

require_absolute_path HOME "$HOME"

hobot_system_root=
if [ -n "${HOBOT_CODE_TEST_INSTALL_ROOT:-}" ]; then
  if [ "${HOBOT_CODE_TESTING:-0}" != 1 ]; then
    printf 'HOBOT_CODE_TEST_INSTALL_ROOT requires HOBOT_CODE_TESTING=1\n' >&2
    exit 1
  fi
  case "$HOBOT_CODE_TEST_INSTALL_ROOT" in
    /|''|*[!A-Za-z0-9_./-]*)
      printf 'HOBOT_CODE_TEST_INSTALL_ROOT is unsafe: %s\n' "$HOBOT_CODE_TEST_INSTALL_ROOT" >&2
      exit 1
      ;;
    /*) ;;
    *) printf 'HOBOT_CODE_TEST_INSTALL_ROOT must be absolute\n' >&2; exit 1 ;;
  esac
  if [ -L "$HOBOT_CODE_TEST_INSTALL_ROOT" ] || [ ! -d "$HOBOT_CODE_TEST_INSTALL_ROOT" ]; then
    printf 'HOBOT_CODE_TEST_INSTALL_ROOT must be a real directory\n' >&2
    exit 1
  fi
  hobot_system_root_logical=$(CDPATH= cd -L -- "$HOBOT_CODE_TEST_INSTALL_ROOT" && pwd -L)
  hobot_system_root=$(CDPATH= cd -P -- "$HOBOT_CODE_TEST_INSTALL_ROOT" && pwd -P)
  if [ "$hobot_system_root_logical" != "$hobot_system_root" ]; then
    printf 'HOBOT_CODE_TEST_INSTALL_ROOT must not traverse symbolic links\n' >&2
    exit 1
  fi
fi
hobot_runtime_root="$hobot_system_root/usr/local/lib/hobot-code"
hobot_install_lock="$hobot_system_root/usr/local/lib/hobot-code.install.lock"

original_umask=$(umask)
umask 077

reject_symlink() {
  link_name=$1
  if [ -L "$link_name" ]; then
    printf 'Refusing Hobot Code path through symbolic link: %s\n' "$link_name" >&2
    exit 1
  fi
}

require_private_file() {
  private_path=$1
  if [ ! -f "$private_path" ]; then
    printf 'Hobot Code credential file must be a regular file: %s\n' "$private_path" >&2
    exit 1
  fi
  if private_owner=$(stat -c %u "$private_path" 2>/dev/null); then
    private_mode=$(stat -c %a "$private_path")
  else
    private_owner=$(stat -f %u "$private_path")
    private_mode=$(stat -f %Lp "$private_path")
  fi
  current_uid=$(id -u)
  if [ "$private_owner" != "$current_uid" ]; then
    printf 'Hobot Code credential file is owned by uid %s, expected %s: %s\n' "$private_owner" "$current_uid" "$private_path" >&2
    exit 1
  fi
  if [ ! -r "$private_path" ]; then
    printf 'Hobot Code credential file is not readable by the current user: %s\n' "$private_path" >&2
    exit 1
  fi
  case "$private_mode" in
    ''|*[!0-7]*)
      printf 'Cannot validate credential file permissions: %s\n' "$private_path" >&2
      exit 1
      ;;
  esac
  if [ $((0$private_mode & 077)) -ne 0 ]; then
    printf 'Hobot Code credential file must not grant group or other access: %s\n' "$private_path" >&2
    exit 1
  fi
}

load_environment_file() {
  environment_file=$1
  environment_line_number=0
  while IFS= read -r environment_line || [ -n "$environment_line" ]; do
    environment_line_number=$((environment_line_number + 1))
    case "$environment_line" in
      ''|'#'*) continue ;;
      *=*) ;;
      *)
        printf '%s:%s must use KEY=VALUE syntax\n' "$environment_file" "$environment_line_number" >&2
        exit 1
        ;;
    esac
    environment_key=${environment_line%%=*}
    environment_value=${environment_line#*=}
    case "$environment_key" in
      ''|[0-9]*|*[!A-Za-z0-9_]*)
        printf '%s:%s has an invalid variable name\n' "$environment_file" "$environment_line_number" >&2
        exit 1
        ;;
      BASH_ENV|BUN_OPTIONS|CDPATH|DYLD_*|ENV|GLOBIGNORE|HOME|IFS|LD_*|NODE_OPTIONS|PATH|PS4|SHELL|SHELLOPTS)
        printf '%s:%s cannot set process-injection variable %s\n' "$environment_file" "$environment_line_number" "$environment_key" >&2
        exit 1
        ;;
      HOBOT_CODE_CONFIG_DIR|XDG_CONFIG_HOME|XDG_STATE_HOME)
        printf '%s:%s must set launcher path variable %s before invoking hobot\n' "$environment_file" "$environment_line_number" "$environment_key" >&2
        exit 1
        ;;
      HOBOT_CODE_GATEWAY_TOKEN_FD|HOBOT_CODE_GATEWAY_TOKEN_FILE)
        printf '%s:%s cannot set reserved credential transport variable %s\n' "$environment_file" "$environment_line_number" "$environment_key" >&2
        exit 1
        ;;
      HOBOT_CODE_TESTING|HOBOT_CODE_TEST_INSTALL_ROOT|HOBOT_CODE_TEST_PROC_ROOT|HOBOT_CODE_TEST_FAIL_AFTER_SWAP)
        printf '%s:%s cannot set reserved launcher test variable %s\n' "$environment_file" "$environment_line_number" "$environment_key" >&2
        exit 1
        ;;
    esac
    case "$environment_value" in
      \"*\") environment_value=${environment_value#\"}; environment_value=${environment_value%\"} ;;
      \'*\') environment_value=${environment_value#\'}; environment_value=${environment_value%\'} ;;
      \"*|*\"|\'*|*\')
        printf '%s:%s has an unmatched quote\n' "$environment_file" "$environment_line_number" >&2
        exit 1
        ;;
    esac
    export "$environment_key=$environment_value"
  done < "$environment_file"
}

setup_usage() {
  cat <<'EOF'
Usage:
  hobot setup [--model ID] [--base-url HTTPS_URL] [--check]
  hobot setup --token-stdin [--model ID] [--base-url HTTPS_URL] [--check]

Without --token-stdin, Hobot Code reads the API token privately from the
controlling terminal. --check verifies the selected route after saving.
EOF
}

validate_setup_model() {
  case "$1" in
    kimi-k3|qwen3.8-max|glm-5.2|deepseek/deepseek-v4-flash|deepseek-v4-pro) ;;
    *)
      printf 'Unsupported D-Robotics model: %s\n' "$1" >&2
      printf 'Choose kimi-k3, qwen3.8-max, glm-5.2, deepseek/deepseek-v4-flash, or deepseek-v4-pro.\n' >&2
      exit 2
      ;;
  esac
}

validate_setup_base_url() {
  setup_url=$1
  case "$setup_url" in
    ''|*[[:space:]]*|*\'*|*\"*|*\\*|*\?*|*\#*)
      printf 'The D-Robotics model gateway URL is invalid.\n' >&2
      exit 2
      ;;
  esac
  case "$setup_url" in
    https://*) ;;
    http://127.0.0.1|http://127.0.0.1/*|http://127.0.0.1:*|http://localhost|http://localhost/*|http://localhost:*)
      if [ "${HOBOT_CODE_TESTING:-0}" != 1 ]; then
        printf 'The D-Robotics model gateway must use HTTPS.\n' >&2
        exit 2
      fi
      ;;
    *)
      printf 'The D-Robotics model gateway must use HTTPS.\n' >&2
      exit 2
      ;;
  esac
  setup_authority=${setup_url#*://}
  setup_authority=${setup_authority%%/*}
  case "$setup_authority" in
    ''|*@*)
      printf 'The D-Robotics model gateway URL must contain a host and no embedded credentials.\n' >&2
      exit 2
      ;;
  esac
}

validate_setup_token() {
  case "$1" in
    '')
      printf 'The D-Robotics API token cannot be empty.\n' >&2
      exit 2
      ;;
    *[!A-Za-z0-9._~+/=-]*)
      printf 'The D-Robotics API token contains unsupported characters.\n' >&2
      exit 2
      ;;
  esac
  if [ "${#1}" -gt 8192 ]; then
    printf 'The D-Robotics API token exceeds the 8192-byte limit.\n' >&2
    exit 2
  fi
}

handle_setup_command() {
  shift
  setup_token_stdin=0
  setup_check=0
  setup_model=${ANTHROPIC_MODEL:-kimi-k3}
  setup_model=${setup_model#drobotics/}
  case "$setup_model" in
    deepseek-v4-flash) setup_model=deepseek/deepseek-v4-flash ;;
    kimi-k3|qwen3.8-max|glm-5.2|deepseek/deepseek-v4-flash|deepseek-v4-pro) ;;
    *) setup_model=kimi-k3 ;;
  esac
  setup_base_url=${ANTHROPIC_BASE_URL:-https://ai-api.d-robotics.cc}
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --token-stdin)
        setup_token_stdin=1
        shift
        ;;
      --model)
        if [ "$#" -lt 2 ]; then
          printf '%s\n' '--model requires a value.' >&2
          exit 2
        fi
        setup_model=$2
        shift 2
        ;;
      --base-url)
        if [ "$#" -lt 2 ]; then
          printf '%s\n' '--base-url requires a value.' >&2
          exit 2
        fi
        setup_base_url=$2
        shift 2
        ;;
      --check)
        setup_check=1
        shift
        ;;
      -h|--help)
        setup_usage
        exit 0
        ;;
      *)
        printf 'Unknown setup option: %s\n' "$1" >&2
        setup_usage >&2
        exit 2
        ;;
    esac
  done

  setup_state_dir=${HOBOT_CODE_STATE_DIR:-$hobot_state_home/hobot-code}
  require_absolute_path HOBOT_CODE_STATE_DIR "$setup_state_dir"

  if [ "$setup_token_stdin" -eq 1 ]; then
    setup_token=
    IFS= read -r setup_token || [ -n "$setup_token" ]
  else
    if [ ! -r /dev/tty ] || [ ! -w /dev/tty ]; then
      printf 'Interactive setup requires a terminal. Pipe the token to hobot setup --token-stdin for automation.\n' >&2
      exit 2
    fi
    printf 'Hobot Code model setup\n' >/dev/tty
    printf 'Model [%s]: ' "$setup_model" >/dev/tty
    setup_answer=
    IFS= read -r setup_answer </dev/tty || exit 130
    if [ -n "$setup_answer" ]; then setup_model=$setup_answer; fi
    printf 'Gateway [%s]: ' "$setup_base_url" >/dev/tty
    setup_answer=
    IFS= read -r setup_answer </dev/tty || exit 130
    if [ -n "$setup_answer" ]; then setup_base_url=$setup_answer; fi
    validate_setup_model "$setup_model"
    validate_setup_base_url "$setup_base_url"
    printf 'API token: ' >/dev/tty
    setup_echo_disabled=0
    restore_setup_echo() {
      if [ "$setup_echo_disabled" -eq 1 ]; then
        stty echo </dev/tty 2>/dev/null || :
        setup_echo_disabled=0
        printf '\n' >/dev/tty
      fi
    }
    trap 'restore_setup_echo; exit 130' HUP INT TERM
    stty -echo </dev/tty
    setup_echo_disabled=1
    setup_token=
    if ! IFS= read -r setup_token </dev/tty; then
      restore_setup_echo
      trap - HUP INT TERM
      exit 130
    fi
    restore_setup_echo
    trap - HUP INT TERM
  fi

  validate_setup_model "$setup_model"
  validate_setup_base_url "$setup_base_url"
  validate_setup_token "$setup_token"

  setup_temp=$(mktemp "$hobot_config_root/.hobot.env.setup.XXXXXX")
  cleanup_setup_temp() {
    if [ -n "${setup_temp:-}" ]; then rm -f "$setup_temp"; fi
  }
  trap 'cleanup_setup_temp' EXIT
  trap 'cleanup_setup_temp; exit 130' HUP INT TERM
  if ! awk '
    index($0, "ANTHROPIC_BASE_URL=") == 1 { next }
    index($0, "ANTHROPIC_AUTH_TOKEN=") == 1 { next }
    index($0, "ANTHROPIC_MODEL=") == 1 { next }
    { print }
  ' "$hobot_config_root/hobot.env" > "$setup_temp"; then
    cleanup_setup_temp
    trap - EXIT HUP INT TERM
    printf 'Could not prepare the Hobot Code model configuration.\n' >&2
    exit 1
  fi
  printf '\nANTHROPIC_BASE_URL=%s\nANTHROPIC_AUTH_TOKEN=%s\nANTHROPIC_MODEL=%s\n' \
    "$setup_base_url" "$setup_token" "$setup_model" >> "$setup_temp"
  chmod 0600 "$setup_temp"
  mv -f "$setup_temp" "$hobot_config_root/hobot.env"
  setup_temp=
  trap - EXIT HUP INT TERM

  printf 'Hobot Code model configuration saved.\n'
  printf 'Model: drobotics/%s\n' "$setup_model"
  printf 'Gateway: %s\n' "$setup_base_url"

  setup_daemon_pid=
  if [ -r "$setup_state_dir/agentd/agentd.pid" ]; then
    setup_daemon_pid=$(sed -n '1p' "$setup_state_dir/agentd/agentd.pid" 2>/dev/null || :)
  fi
  case "$setup_daemon_pid" in
    ''|*[!0-9]*) ;;
    *)
      if kill -0 "$setup_daemon_pid" 2>/dev/null; then
        printf 'The background service is still using its previous configuration. Run: hobot daemon restart\n' >&2
        if [ "$setup_check" -eq 1 ]; then
          printf 'Restart the background service, then run: hobot model check drobotics/%s\n' "$setup_model" >&2
          exit 0
        fi
      fi
      ;;
  esac
  if [ "$setup_check" -eq 1 ]; then
    exec "$0" model check "drobotics/$setup_model"
  fi
  printf 'Verify the route when ready: hobot model check drobotics/%s\n' "$setup_model"
  printf 'Start Hobot Code from a project directory: cd /path/to/project && hobot\n'
  exit 0
}

export_config_fingerprint() {
  unset HOBOT_CODE_CONFIG_FINGERPRINT
  config_fingerprint=
  if command -v sha256sum >/dev/null 2>&1; then
    environment_digest=$(sha256sum "$hobot_config_root/hobot.env" | awk 'NR == 1 { print $1 }')
    settings_digest=$(sha256sum "$hobot_agent_dir/settings.json" | awk 'NR == 1 { print $1 }')
    models_digest=$(sha256sum "$hobot_agent_dir/models.json" | awk 'NR == 1 { print $1 }')
    providers_digest=$(sha256sum "$hobot_managed_provider_config" | awk 'NR == 1 { print $1 }')
    config_fingerprint=$(printf '%s\n%s\n%s\n%s\n' "$environment_digest" "$settings_digest" "$models_digest" "$providers_digest" | sha256sum | awk 'NR == 1 { print $1 }')
  elif command -v shasum >/dev/null 2>&1; then
    environment_digest=$(shasum -a 256 "$hobot_config_root/hobot.env" | awk 'NR == 1 { print $1 }')
    settings_digest=$(shasum -a 256 "$hobot_agent_dir/settings.json" | awk 'NR == 1 { print $1 }')
    models_digest=$(shasum -a 256 "$hobot_agent_dir/models.json" | awk 'NR == 1 { print $1 }')
    providers_digest=$(shasum -a 256 "$hobot_managed_provider_config" | awk 'NR == 1 { print $1 }')
    config_fingerprint=$(printf '%s\n%s\n%s\n%s\n' "$environment_digest" "$settings_digest" "$models_digest" "$providers_digest" | shasum -a 256 | awk 'NR == 1 { print $1 }')
  fi
  case "$config_fingerprint" in
    *[!0-9a-f]*|'') ;;
    *)
      if [ "${#config_fingerprint}" -eq 64 ]; then
        HOBOT_CODE_CONFIG_FINGERPRINT=$config_fingerprint
        export HOBOT_CODE_CONFIG_FINGERPRINT
      fi
      ;;
  esac
}

has_model_configuration() {
  if [ -n "${ANTHROPIC_AUTH_TOKEN:-}" ]; then
    return 0
  fi
  if env | grep -Eq '^HOBOT_CODE_PROVIDER_KEY_[A-Z0-9_]+=.+$'; then
    return 0
  fi
  if [ -f "$hobot_agent_dir/auth.json" ] && [ ! -L "$hobot_agent_dir/auth.json" ] && [ -s "$hobot_agent_dir/auth.json" ]; then
    return 0
  fi
  if command -v cmp >/dev/null 2>&1 && ! cmp -s "$hobot_agent_dir/models.json" "$hobot_default_config/models.json"; then
    return 0
  fi
  return 1
}

persistent_usage() {
  cat <<'EOF'
Usage:
  hobot persistent
  hobot persistent start [name] [-- hobot-options...]
  hobot persistent attach [name]
  hobot persistent list
  hobot persistent stop [name]

The default name is "main". Detach with Ctrl+B, then D.
EOF
}

handle_product_command() {
  case "${1:-}" in
    update)
      if [ "${2:-}" = --extensions ]; then return 1; fi
      shift
      exec "$hobot_runtime_root/release.sh" update "$@"
      ;;
    uninstall)
      shift
      exec "$hobot_runtime_root/uninstall.sh" "$@"
      ;;
  esac
  return 1
}

refuse_during_install() {
  install_lock=$hobot_install_lock
  if [ "${HOBOT_CODE_TESTING:-0}" = 1 ] && [ -n "${HOBOT_CODE_TEST_INSTALL_LOCK:-}" ]; then
    require_absolute_path HOBOT_CODE_TEST_INSTALL_LOCK "$HOBOT_CODE_TEST_INSTALL_LOCK"
    install_lock=$HOBOT_CODE_TEST_INSTALL_LOCK
  fi
  if [ ! -d "$install_lock" ]; then return; fi
  printf 'A Hobot Code install or rollback is in progress. Try again after it finishes.\n' >&2
  exit 75
}

require_tmux() {
  if ! command -v tmux >/dev/null 2>&1; then
    printf 'Persistent Hobot Code sessions require tmux. Install it with: sudo apt-get install tmux\n' >&2
    exit 127
  fi
  if [ ! -f "$hobot_tmux_config" ] || [ ! -r "$hobot_tmux_config" ]; then
    printf 'Hobot Code tmux configuration is missing or unreadable: %s\n' "$hobot_tmux_config" >&2
    exit 1
  fi
}

clear_persistent_model_credentials() {
  unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
  persistent_credential_names=$(env | sed -n 's/^\(HOBOT_CODE_PROVIDER_KEY_[A-Z0-9_][A-Z0-9_]*\)=.*/\1/p')
  for persistent_credential_name in $persistent_credential_names; do
    unset "$persistent_credential_name"
  done
  unset persistent_credential_name persistent_credential_names
}

persistent_session_name() {
  logical_name=${1:-main}
  case "$logical_name" in
    ''|*[!A-Za-z0-9_-]*|[-_]*|?????????????????????????????????????????????????*)
      printf 'Persistent session names must start with a letter or digit, use only A-Z, a-z, 0-9, _ or -, and contain at most 48 characters: %s\n' "$logical_name" >&2
      exit 2
      ;;
  esac
  printf 'hobot-code-%s\n' "$logical_name"
}

append_shell_word() {
  shell_word=$(printf '%sX' "$1" | sed "s/'/'\\\\''/g")
  shell_word=${shell_word%X}
  persistent_command="$persistent_command '$shell_word'"
}

attach_persistent_session() {
  target_session=$1
  if [ -n "${TMUX:-}" ]; then
    case "${TMUX%%,*}" in
      */hobot-code) exec tmux -L hobot-code -f "$hobot_tmux_config" switch-client -t "=$target_session" ;;
      *)
        printf 'Cannot attach the isolated Hobot Code server from another tmux client. Detach first, then run the command again.\n' >&2
        exit 1
        ;;
    esac
  fi
  exec tmux -L hobot-code -f "$hobot_tmux_config" attach-session -t "=$target_session"
}

handle_persistent_command() {
  shift
  persistent_action=${1:-start}
  if [ "$#" -gt 0 ]; then shift; fi
  # The inner launcher reloads the private configuration. The dedicated tmux
  # server must never retain model credentials in its long-lived environment.
  clear_persistent_model_credentials

  case "$persistent_action" in
    help|-h|--help)
      persistent_usage
      exit 0
      ;;
    list)
      if [ "$#" -ne 0 ]; then
        printf 'Usage: hobot persistent list\n' >&2
        exit 2
      fi
      require_tmux
      persistent_sessions=$(tmux -L hobot-code -f "$hobot_tmux_config" list-sessions -F '#{session_name}|#{session_attached}|#{session_windows}|#{t:session_created}' 2>/dev/null || :)
      persistent_sessions=$(printf '%s\n' "$persistent_sessions" | sed -n '/^hobot-code-/p')
      if [ -z "$persistent_sessions" ]; then
        printf 'No persistent Hobot Code sessions.\n'
        exit 0
      fi
      printf 'NAME\tATTACHED\tWINDOWS\tCREATED\n'
      printf '%s\n' "$persistent_sessions" | awk -F '|' '{ sub(/^hobot-code-/, "", $1); printf "%s\t%s\t%s\t%s\n", $1, $2, $3, $4 }'
      exit 0
      ;;
    attach|stop)
      if [ "$#" -gt 1 ]; then
        printf 'Usage: hobot persistent %s [name]\n' "$persistent_action" >&2
        exit 2
      fi
      require_tmux
      target_session=$(persistent_session_name "${1:-main}")
      if ! tmux -L hobot-code -f "$hobot_tmux_config" has-session -t "=$target_session" 2>/dev/null; then
        printf 'Persistent Hobot Code session does not exist: %s\n' "${1:-main}" >&2
        exit 1
      fi
      if [ "$persistent_action" = stop ]; then
        tmux -L hobot-code -f "$hobot_tmux_config" kill-session -t "=$target_session"
        printf 'Stopped persistent Hobot Code session: %s\n' "${1:-main}"
        exit 0
      fi
      attach_persistent_session "$target_session"
      ;;
    start)
      require_tmux
      logical_name=main
      if [ "$#" -gt 0 ] && [ "$1" != -- ]; then
        logical_name=$1
        shift
      fi
      if [ "$#" -gt 0 ]; then
        if [ "$1" != -- ]; then
          printf 'Hobot options must follow --: hobot persistent start [name] [-- hobot-options...]\n' >&2
          exit 2
        fi
        shift
      fi
      target_session=$(persistent_session_name "$logical_name")
      if tmux -L hobot-code -f "$hobot_tmux_config" has-session -t "=$target_session" 2>/dev/null; then
        if [ "$#" -gt 0 ]; then
          printf 'Persistent session %s already exists; new Hobot options were ignored.\n' "$logical_name" >&2
        fi
        attach_persistent_session "$target_session"
      fi

      case "$0" in
        /*) hobot_launcher=$0 ;;
        *)
          hobot_launcher=$(command -v "$0" 2>/dev/null || :)
          case "$hobot_launcher" in
            /*) ;;
            *)
              printf 'Cannot resolve the Hobot Code launcher path: %s\n' "$0" >&2
              exit 1
              ;;
          esac
          ;;
      esac
      persistent_command=exec
      append_shell_word "$hobot_launcher"
      for persistent_arg in "$@"; do append_shell_word "$persistent_arg"; done

      if [ -n "${TMUX:-}" ]; then
        case "${TMUX%%,*}" in
          */hobot-code) ;;
          *)
            printf 'Cannot start an isolated Hobot Code session from another tmux client. Detach first, then run the command again.\n' >&2
            exit 1
            ;;
        esac
        tmux -L hobot-code -f "$hobot_tmux_config" new-session -d -s "$target_session" -c "$PWD" "$persistent_command"
        attach_persistent_session "$target_session"
      fi
      exec tmux -L hobot-code -f "$hobot_tmux_config" new-session -s "$target_session" -c "$PWD" "$persistent_command"
      ;;
    *)
      printf 'Unknown persistent action: %s\n' "$persistent_action" >&2
      persistent_usage >&2
      exit 2
      ;;
  esac
}

hobot_config_home=${XDG_CONFIG_HOME:-$HOME/.config}
hobot_state_home=${XDG_STATE_HOME:-$HOME/.local/state}
hobot_config_root=${HOBOT_CODE_CONFIG_DIR:-$hobot_config_home/hobot-code}
hobot_default_config="$hobot_runtime_root/default-config"
hobot_tmux_config="$hobot_runtime_root/tmux.conf"
require_absolute_path XDG_CONFIG_HOME "$hobot_config_home"
require_absolute_path XDG_STATE_HOME "$hobot_state_home"
require_absolute_path HOBOT_CODE_CONFIG_DIR "$hobot_config_root"
require_scoped_private_root HOBOT_CODE_CONFIG_DIR "$hobot_config_root"

handle_product_command "$@" || :
refuse_during_install "$@"

reject_symlink "$hobot_config_root"
reject_symlink "$hobot_config_root/agent"
mkdir -p "$hobot_config_root" "$hobot_config_root/agent"
chmod 0700 "$hobot_config_root" "$hobot_config_root/agent"
reject_symlink "$hobot_config_root/hobot.env"
if [ ! -e "$hobot_config_root/hobot.env" ]; then
  cp "$hobot_default_config/hobot.env.example" "$hobot_config_root/hobot.env"
  chmod 0600 "$hobot_config_root/hobot.env"
fi
require_private_file "$hobot_config_root/hobot.env"

load_environment_file "$hobot_config_root/hobot.env"
if [ "${1:-}" = setup ]; then
  handle_setup_command "$@"
fi

hobot_agent_dir=${HOBOT_CODING_AGENT_DIR:-$hobot_config_root/agent}
hobot_state_dir=${HOBOT_CODE_STATE_DIR:-$hobot_state_home/hobot-code}
hobot_session_dir=${HOBOT_CODING_AGENT_SESSION_DIR:-$hobot_state_dir/sessions}
hobot_tmux_runtime_dir=$hobot_state_dir/tmux
hobot_permission_policy=${HOBOT_CODE_PERMISSION_POLICY:-$hobot_agent_dir/permissions.json}
hobot_memory_config=${HOBOT_CODE_MEMORY_CONFIG:-$hobot_agent_dir/memory.json}
hobot_memory_db=${HOBOT_CODE_MEMORY_DB:-$hobot_state_dir/memory/memory.db}
hobot_goal_config=${HOBOT_CODE_GOAL_CONFIG:-$hobot_agent_dir/goals.json}
hobot_goal_db=${HOBOT_CODE_GOAL_DB:-$hobot_state_dir/goals/goals.db}
hobot_hook_config=${HOBOT_CODE_HOOK_CONFIG:-$hobot_agent_dir/hooks.json}
hobot_hook_audit=${HOBOT_CODE_HOOK_AUDIT:-$hobot_state_dir/audit/hooks.jsonl}
hobot_notification_config=${HOBOT_CODE_NOTIFICATION_CONFIG:-$hobot_agent_dir/notifications.json}
hobot_lsp_config=${HOBOT_CODE_LSP_CONFIG:-$hobot_agent_dir/lsp.json}
hobot_managed_provider_config=${HOBOT_CODE_MANAGED_PROVIDER_CONFIG:-$hobot_agent_dir/providers.json}
hobot_rdk_knowledge_dir=${HOBOT_CODE_RDK_KNOWLEDGE_DIR:-$hobot_runtime_root/knowledge}
hobot_rdk_expert_prompt=${HOBOT_CODE_RDK_EXPERT_PROMPT:-$hobot_runtime_root/prompts/rdk-expert.md}
hobot_extension_catalog=${HOBOT_CODE_EXTENSION_CATALOG:-$hobot_runtime_root/extensions/catalog.json}
require_absolute_path HOBOT_CODING_AGENT_DIR "$hobot_agent_dir"
require_absolute_path HOBOT_CODE_STATE_DIR "$hobot_state_dir"
require_absolute_path HOBOT_CODING_AGENT_SESSION_DIR "$hobot_session_dir"
require_scoped_private_root HOBOT_CODING_AGENT_DIR "$hobot_agent_dir"
require_scoped_private_root HOBOT_CODE_STATE_DIR "$hobot_state_dir"
require_scoped_private_root HOBOT_CODING_AGENT_SESSION_DIR "$hobot_session_dir"
require_absolute_path HOBOT_CODE_PERMISSION_POLICY "$hobot_permission_policy"
require_absolute_path HOBOT_CODE_MEMORY_CONFIG "$hobot_memory_config"
require_absolute_path HOBOT_CODE_MEMORY_DB "$hobot_memory_db"
require_absolute_path HOBOT_CODE_GOAL_CONFIG "$hobot_goal_config"
require_absolute_path HOBOT_CODE_GOAL_DB "$hobot_goal_db"
require_absolute_path HOBOT_CODE_HOOK_CONFIG "$hobot_hook_config"
require_absolute_path HOBOT_CODE_HOOK_AUDIT "$hobot_hook_audit"
require_absolute_path HOBOT_CODE_NOTIFICATION_CONFIG "$hobot_notification_config"
require_absolute_path HOBOT_CODE_LSP_CONFIG "$hobot_lsp_config"
require_absolute_path HOBOT_CODE_MANAGED_PROVIDER_CONFIG "$hobot_managed_provider_config"
require_absolute_path HOBOT_CODE_RDK_KNOWLEDGE_DIR "$hobot_rdk_knowledge_dir"
require_absolute_path HOBOT_CODE_RDK_EXPERT_PROMPT "$hobot_rdk_expert_prompt"
require_absolute_path HOBOT_CODE_EXTENSION_CATALOG "$hobot_extension_catalog"

for hobot_path in "$hobot_agent_dir" "$hobot_state_dir" "$hobot_session_dir" "$hobot_state_dir/memory" "$hobot_state_dir/goals" "$hobot_state_dir/audit" "$hobot_tmux_runtime_dir"; do
  reject_symlink "$hobot_path"
done
mkdir -p "$hobot_agent_dir" "$hobot_session_dir" "$hobot_state_dir/memory" "$hobot_state_dir/goals" "$hobot_state_dir/audit" "$hobot_tmux_runtime_dir"
chmod 0700 "$hobot_agent_dir" "$hobot_state_dir" "$hobot_session_dir" "$hobot_state_dir/memory" "$hobot_state_dir/goals" "$hobot_state_dir/audit" "$hobot_tmux_runtime_dir"
for hobot_config_name in settings.json models.json providers.json permissions.json memory.json goals.json hooks.json notifications.json lsp.json; do
  reject_symlink "$hobot_agent_dir/$hobot_config_name"
  if [ -e "$hobot_agent_dir/$hobot_config_name" ] && [ ! -f "$hobot_agent_dir/$hobot_config_name" ]; then
    printf 'Hobot Code configuration must be a regular file: %s\n' "$hobot_agent_dir/$hobot_config_name" >&2
    exit 1
  fi
  if [ ! -e "$hobot_agent_dir/$hobot_config_name" ]; then
    cp "$hobot_default_config/$hobot_config_name" "$hobot_agent_dir/$hobot_config_name"
  fi
  chmod 0600 "$hobot_agent_dir/$hobot_config_name"
done

require_private_file "$hobot_managed_provider_config"

export_config_fingerprint

export HOBOT_CODING_AGENT_DIR="$hobot_agent_dir"
export HOBOT_CODING_AGENT_SESSION_DIR="$hobot_session_dir"
export HOBOT_CODE_STATE_DIR="$hobot_state_dir"
export HOBOT_CODE_PERMISSION_POLICY="$hobot_permission_policy"
export HOBOT_CODE_MEMORY_CONFIG="$hobot_memory_config"
export HOBOT_CODE_MEMORY_DB="$hobot_memory_db"
export HOBOT_CODE_GOAL_CONFIG="$hobot_goal_config"
export HOBOT_CODE_GOAL_DB="$hobot_goal_db"
export HOBOT_CODE_HOOK_CONFIG="$hobot_hook_config"
export HOBOT_CODE_HOOK_AUDIT="$hobot_hook_audit"
export HOBOT_CODE_NOTIFICATION_CONFIG="$hobot_notification_config"
export HOBOT_CODE_LSP_CONFIG="$hobot_lsp_config"
export HOBOT_CODE_MANAGED_PROVIDER_CONFIG="$hobot_managed_provider_config"
export HOBOT_CODE_RDK_KNOWLEDGE_DIR="$hobot_rdk_knowledge_dir"
export HOBOT_CODE_RDK_EXPERT_PROMPT="$hobot_rdk_expert_prompt"
export HOBOT_CODE_EXTENSION_CATALOG="$hobot_extension_catalog"
export TMUX_TMPDIR="$hobot_tmux_runtime_dir"
if [ -r "$hobot_runtime_root/VERSION" ]; then
  HOBOT_CODE_VERSION=$(sed -n '1p' "$hobot_runtime_root/VERSION")
  export HOBOT_CODE_VERSION
fi
export PI_SKIP_VERSION_CHECK="${PI_SKIP_VERSION_CHECK:-1}"
export PATH="$hobot_runtime_root/bin:$PATH"

if [ "$#" -eq 0 ] && ! has_model_configuration; then
  umask "$original_umask"
  cat >&2 <<'EOF'
Hobot Code needs a model provider before the first conversation.

Configure D-Robotics models:
  hobot setup

Or add another provider:
  hobot provider add --help

Run `hobot doctor` to inspect readiness. `hobot tui` remains available for
deliberate configuration-free inspection.
EOF
  exit 2
fi

umask "$original_umask"
case "${1:-}" in
  tui|daemon|deploy|task|bridge|doctor|diagnose|extensions|provider|model|workspace) exec "$hobot_runtime_root/agentd" "$@" ;;
esac
if [ "${1:-}" = persistent ]; then
  handle_persistent_command "$@"
fi
exec "$hobot_runtime_root/agentd" tui -- "$@"
