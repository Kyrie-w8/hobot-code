{
  "defaultProvider": "drobotics",
  "defaultModel": "kimi-k3",
  "defaultThinkingLevel": "max",
  "hideThinkingBlock": false,
  "quietStartup": false,
  "collapseChangelog": true,
  "defaultProjectTrust": "ask",
  "enableInstallTelemetry": false,
  "tuiMode": "fullscreen",
  "doubleEscapeAction": "tree",
  "outputPad": 1,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 3000000,
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "httpIdleTimeoutMs": 3000000,
  "enabledModels": [
    "drobotics/kimi-k3",
    "drobotics/qwen3.8-max",
    "drobotics/glm-5.2",
    "drobotics/deepseek-v4-flash",
    "drobotics/deepseek-v4-pro"
  ],
  "extensions": [
    "/usr/local/lib/hobot-code/extensions"
  ],
  "skills": [
    "/usr/local/lib/hobot-code/skills"
  ],
  "enableSkillCommands": true
}
