[Unit]
Description=Aster embedded agent service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/aster/workspace
EnvironmentFile=-/etc/aster/aster.env
ExecStart=/usr/local/bin/aster --config /etc/aster/config.json serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aster

[Install]
WantedBy=multi-user.target
